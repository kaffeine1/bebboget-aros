# Native or SDK-based AROS build.
# Builds bebboget, installcerts and the crypto self-tests from a static library.
# The m68k assembly is not used: the C code paths of the linux build are taken.

CC ?= gcc
CXX ?= g++
AR ?= ar
ARFLAGS ?= rcs
STRIP ?= strip
OBJCOPY ?= objcopy
STRIPFLAGS ?= --strip-unneeded -R.comment
STRIP_OUTPUTS ?= $(if $(strip $(AROS_SDK_ROOT)),yes,)
POST_LINK ?= :
TARGET_CFLAGS ?=
OUTDIR ?= aros-i386
AROS_TARGET_TRIPLET ?= i386-aros
srcdir := src

AROS_SDK_ROOT ?=

ifeq ($(strip $(AROS_SDK_ROOT)),)
SDK_CPPFLAGS ?=
SDK_LDFLAGS ?=
SDK_LIBS ?=
STARTUP ?=
else
SDK_GCC_VERSION ?= 6.5.0
SDK_GCC_ROOT ?= $(AROS_SDK_ROOT)/lib/gcc/$(AROS_TARGET_TRIPLET)/$(SDK_GCC_VERSION)
SDK_CPPFLAGS = -nostdinc \
	-isystem "$(SDK_GCC_ROOT)/include/c++" \
	-isystem "$(SDK_GCC_ROOT)/include/c++/$(AROS_TARGET_TRIPLET)" \
	-isystem "$(SDK_GCC_ROOT)/include" \
	-isystem "$(SDK_GCC_ROOT)/include-fixed" \
	-I"$(AROS_SDK_ROOT)/include/aros/posixc" \
	-I"$(AROS_SDK_ROOT)/include/aros/stdc" \
	-I"$(AROS_SDK_ROOT)/include"
SDK_LDFLAGS = -nostdlib -L"$(AROS_SDK_ROOT)/lib" -L"$(SDK_GCC_ROOT)"
SDK_LIBS ?= -lautoinit -lcrtprog -lcrt -lstdlib -lstdc.static \
	-lamiga -laros -ldos -lexec -lutility -lgcc -lautoinit -lamiga
STARTUP ?= "$(AROS_SDK_ROOT)/lib/startup.o"
endif

CFLAGS ?= $(SDK_CPPFLAGS) -Iinclude -O2 -fno-builtin -include compat_endian.h $(TARGET_CFLAGS)
CXXFLAGS ?= -fno-exceptions -fno-rtti
LDFLAGS ?= $(SDK_LDFLAGS) -L$(OUTDIR)
LIBS = -lbebboget $(SDK_LIBS)

LIB_SOURCES ?= socket_glue_aros.c bg.cpp \
	biginteger.cpp unhexlify.c equals.cpp dump.c \
	stream.cpp socket.cpp \
	vector.cpp c++support.cpp \
	chacha20.cpp poly1305.cpp chacha20poly1305.cpp \
	md.cpp sha256.cpp sha384512.cpp sha512.cpp sha384.cpp sha.cpp md5.cpp bc.cpp \
	aes.cpp rc4.cpp des.cpp des3.cpp gcm.cpp \
	rand.c aros_randpool.cpp log.c mimedecode.c certstuff.cpp \
	x25519.cpp \
	pkcs6.cpp ecmath.cpp fastmath.cpp asn1.cpp secpXXXr1.cpp \
	ssl3.cpp ssl3client.cpp

BEBBOGET_SOURCES ?= bebboget.cpp
INSTALLCERTS_SOURCES ?= installcerts.cpp
TEST_SOURCES ?= $(notdir $(wildcard $(srcdir)/test*.cpp))

# as in the upstream Makefile
O3_OBJECTS = $(OUTDIR)/aes.o $(OUTDIR)/gcm.o $(OUTDIR)/chacha20.o $(OUTDIR)/biginteger.o $(OUTDIR)/fastmath.o

LIB_OBJECTS = $(patsubst %.cpp,$(OUTDIR)/%.o,$(patsubst %.c,$(OUTDIR)/%.o,$(LIB_SOURCES)))
BEBBOGET_OBJECTS = $(patsubst %.cpp,$(OUTDIR)/%.o,$(BEBBOGET_SOURCES))
INSTALLCERTS_OBJECTS = $(patsubst %.cpp,$(OUTDIR)/%.o,$(INSTALLCERTS_SOURCES))
TESTS = $(patsubst %.cpp,$(OUTDIR)/%,$(TEST_SOURCES))
HEADERS = $(shell find include -type f)

.PHONY: all bebboget installcerts tests clean

all: bebboget installcerts tests

bebboget: $(OUTDIR)/bebboget

installcerts: $(OUTDIR)/installcerts

tests: $(TESTS)

$(OUTDIR):
	mkdir -p $(OUTDIR)

$(OUTDIR)/libbebboget.a: $(LIB_OBJECTS)
	rm -f $@
	$(AR) $(ARFLAGS) $@ $(LIB_OBJECTS)

$(OUTDIR)/bebboget: $(BEBBOGET_OBJECTS) $(OUTDIR)/libbebboget.a
	$(CXX) $(LDFLAGS) $(STARTUP) $(BEBBOGET_OBJECTS) $(LIBS) -o $@
ifneq ($(strip $(STRIP_OUTPUTS)),)
	$(STRIP) $(STRIPFLAGS) $@
endif
	$(POST_LINK)

$(OUTDIR)/installcerts: $(INSTALLCERTS_OBJECTS) $(OUTDIR)/libbebboget.a
	$(CXX) $(LDFLAGS) $(STARTUP) $(INSTALLCERTS_OBJECTS) $(LIBS) -o $@
ifneq ($(strip $(STRIP_OUTPUTS)),)
	$(STRIP) $(STRIPFLAGS) $@
endif
	$(POST_LINK)

$(OUTDIR)/test%: $(OUTDIR)/test%.o $(OUTDIR)/libbebboget.a
	$(CXX) $(LDFLAGS) $(STARTUP) $< $(LIBS) -o $@
ifneq ($(strip $(STRIP_OUTPUTS)),)
	$(STRIP) $(STRIPFLAGS) $@
endif
	$(POST_LINK)

$(O3_OBJECTS): CFLAGS += -O3

$(OUTDIR)/%.o: $(srcdir)/%.cpp $(MAKEFILE_LIST) $(HEADERS) | $(OUTDIR)
	$(CXX) -c $(CFLAGS) $(CXXFLAGS) $< -o $@

$(OUTDIR)/%.o: $(srcdir)/%.c $(MAKEFILE_LIST) $(HEADERS) | $(OUTDIR)
	$(CC) -c $(CFLAGS) $< -o $@

clean:
	rm -rf $(OUTDIR)
